# ==============================================================================
# FINTRACK ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit the actual .env file or real secrets to version control.
# - Generate cryptographically secure random secrets for production using:
#     openssl rand -hex 32
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Global Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Internal Microservice Authentication Secret
# ------------------------------------------------------------------------------
# Purpose: Shared secret used to authenticate the API Gateway to downstream
# internal microservices (Auth, Transaction, Notification Service).
# Transmitted downstream by the API Gateway in the 'x-internal-token' header.
# Any direct request bypassing the API Gateway without this valid header is rejected with 403 Forbidden.
# In production, services will fail to start if this secret is missing or empty.
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_SECRET=change_in_production_generate_with_openssl_rand_hex_32

# ------------------------------------------------------------------------------
# 3. JWT Authentication Secrets
# ------------------------------------------------------------------------------
# Used for signing and verifying short-lived access tokens and refresh tokens.
# Must be at least 32 characters in length.
# Generate with: openssl rand -hex 32
JWT_SECRET=change_in_production_jwt_access_secret_32_chars_min
JWT_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=change_in_production_refresh_token_secret_32_chars_min
REFRESH_TOKEN_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Message Broker (RabbitMQ)
# ------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=change_in_production_rabbitmq_password
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ------------------------------------------------------------------------------
# 5. API Gateway Configuration
# ------------------------------------------------------------------------------
PORT=8000
GATEWAY_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Downstream internal service URLs for Gateway routing
# When running in Docker Compose, internal DNS names are used:
#   AUTH_SERVICE_URL=http://auth-service:5001
#   TRANSACTION_SERVICE_URL=http://transaction-service:5002
#   NOTIFICATION_SERVICE_URL=http://notification-service:5003
AUTH_SERVICE_URL=http://localhost:5001
TRANSACTION_SERVICE_URL=http://localhost:5002
NOTIFICATION_SERVICE_URL=http://localhost:5003

# ------------------------------------------------------------------------------
# 6. Auth Service Configuration
# ------------------------------------------------------------------------------
AUTH_PORT=5001
AUTH_MONGO_URI=mongodb://localhost:27018/fintrack_auth

# Cookie Security Configuration
# In production, set COOKIE_SECURE=true and COOKIE_SAMESITE=strict (or lax)
COOKIE_PATH=/api/auth
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# 7. Transaction Service Configuration
# ------------------------------------------------------------------------------
TRANSACTION_PORT=5002
TRANSACTION_MONGO_URI=mongodb://localhost:27019/fintrack_transactions
EXCHANGE_NAME=fintrack_events
ROUTING_KEY_EXPENSE=expense.created

# ------------------------------------------------------------------------------
# 8. Notification Service Configuration
# ------------------------------------------------------------------------------
NOTIFICATION_PORT=5003
NOTIFICATION_MONGO_URI=mongodb://localhost:27020/fintrack_notifications
QUEUE_NAME=notifications_expense_queue
DEFAULT_ALERT_THRESHOLD=10000

# RabbitMQ Reliability & Retry Pipeline Settings
MAX_RETRIES=3
RETRY_DELAY_MS=5000
RETRY_QUEUE_NAME=notifications_expense_retry_queue
DLX_NAME=fintrack_dlx
DLQ_NAME=notifications_expense_dlq

# ------------------------------------------------------------------------------
# 9. Frontend Configuration
# ------------------------------------------------------------------------------
VITE_API_GATEWAY_URL=http://localhost:8000/api
