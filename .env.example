# ==========================================
# FINTRACK ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# Environment Mode
NODE_ENV=development

# -----------------
# API Gateway
# -----------------
GATEWAY_PORT=8000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=fintrack_jwt_access_super_secret_key_change_in_production_32chars
AUTH_SERVICE_URL=http://localhost:5001
TRANSACTION_SERVICE_URL=http://localhost:5002
NOTIFICATION_SERVICE_URL=http://localhost:5003

# -----------------
# Auth Service
# -----------------
AUTH_PORT=5001
AUTH_MONGO_URI=mongodb://localhost:27017/fintrack_auth
JWT_SECRET=fintrack_jwt_access_super_secret_key_change_in_production_32chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=fintrack_jwt_refresh_super_secret_key_change_in_production_32chars
REFRESH_TOKEN_EXPIRES_IN=7d

# -----------------
# Transaction Service
# -----------------
TRANSACTION_PORT=5002
TRANSACTION_MONGO_URI=mongodb://localhost:27017/fintrack_transactions
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# -----------------
# Notification Service
# -----------------
NOTIFICATION_PORT=5003
NOTIFICATION_MONGO_URI=mongodb://localhost:27017/fintrack_notifications
RABBITMQ_URL=amqp://guest:guest@localhost:5672
DEFAULT_ALERT_THRESHOLD=10000

# -----------------
# Frontend
# -----------------
VITE_API_GATEWAY_URL=http://localhost:8000/api
