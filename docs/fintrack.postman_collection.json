{
  "info": {
    "name": "FinTrack Microservices API Collection",
    "description": "Postman Collection for testing all FinTrack API endpoints via API Gateway",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health Checks",
      "item": [
        {
          "name": "Gateway Health",
          "request": {
            "method": "GET",
            "url": "http://localhost:8000/health"
          }
        },
        {
          "name": "Auth Service Health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/health"
          }
        },
        {
          "name": "Transaction Service Health",
          "request": {
            "method": "GET",
            "url": "http://localhost:5002/health"
          }
        },
        {
          "name": "Notification Service Health",
          "request": {
            "method": "GET",
            "url": "http://localhost:5003/health"
          }
        }
      ]
    },
    {
      "name": "Auth Service",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Aditya Tiwari\",\n  \"email\": \"aditya@example.com\",\n  \"password\": \"Password@123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('token', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@fintrack.app\",\n  \"password\": \"Demo@1234\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "Transaction Service",
      "item": [
        {
          "name": "Get Transactions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/transactions?month=2026-11&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"],
              "query": [
                { "key": "month", "value": "2026-11" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Create Income Transaction",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/transactions",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 85000,\n  \"type\": \"income\",\n  \"category\": \"Salary\",\n  \"date\": \"2026-11-01T09:00:00.000Z\",\n  \"note\": \"Tech Corp Salary\"\n}"
            }
          }
        },
        {
          "name": "Create Expense Transaction (Triggers Alert)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/transactions",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 25000,\n  \"type\": \"expense\",\n  \"category\": \"Rent & Housing\",\n  \"date\": \"2026-11-02T10:00:00.000Z\",\n  \"note\": \"Monthly Apartment Rent\"\n}"
            }
          }
        },
        {
          "name": "Get Monthly Summary",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/transactions/summary?month=2026-11",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "summary"],
              "query": [{ "key": "month", "value": "2026-11" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Notification Service",
      "item": [
        {
          "name": "Get Notifications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/notifications",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Get Alert Threshold",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/settings/threshold",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Set Alert Threshold",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/settings/threshold",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"threshold\": 10000\n}"
            }
          }
        }
      ]
    }
  ]
}
